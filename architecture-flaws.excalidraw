    {
      "type": "text",
      "id": "export_timeout_desc",
      "x": 570, "y": 660,
      "width": 410, "height": 100,
      "text": "File: app/api/export/route.ts\n\n1. Unauthenticated Chromium PDF endpoint. \n2. Sequential for-loop of exports (PDF + DOCX) \nexceeds Vercel's 60s maxDuration limit \nleading to constant cold-start timeouts.",
      "originalText": "File: app/api/export/route.ts\n\n1. Unauthenticated Chromium PDF endpoint. \n2. Sequential for-loop of exports (PDF + DOCX) \nexceeds Vercel's 60s maxDuration limit \nleading to constant cold-start timeouts.",
