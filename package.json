{
  "name": "oc-cv-maker",
  "version": "2.0.0",
  "description": "AI-powered bilingual CV generator (English + Arabic) — web app with chat interview, PDF/DOCX export.",
  "author": "Yusuf Imad",
  "main": "src/index.js",
  "bin": {
    "cv-maker": "src/index.js"
  },
  "scripts": {
    "dev": "concurrently \"npm:dev:backend\" \"npm:dev:web\"",
    "dev:web": "next dev",
    "dev:backend": "convex dev",
    "typegen": "next typegen",
    "build": "npx convex codegen && next typegen && next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "cli": "node src/index.js",
    "cli:generate": "node src/index.js",
    "cli:test:en": "node src/index.js --from-json sample-data.json",
    "cli:test:ar": "node src/index.js --from-json sample-data-ar.json",
    "cli:test:ar:simple": "node src/index.js --from-json sample-data-ar-simple.json",
    "cli:test:ar:marketing": "node src/index.js --from-json sample-data-ar-marketing.json",
    "cli:test:all": "node src/index.js --from-json sample-data.json && node src/index.js --from-json sample-data-ar.json"
  },
  "keywords": [
    "cv",
    "resume",
    "generator",
    "ai",
    "bilingual",
    "arabic",
    "nextjs"
  ],
  "license": "ISC",
  "dependencies": {
    "@convex-dev/auth": "^0.0.92",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/manrope": "^5.2.8",
    "@fontsource/tajawal": "^5.2.7",
    "@inquirer/prompts": "^8.4.3",
    "@sparticuz/chromium-min": "^148.0.0",
    "@vercel/analytics": "^2.0.1",
    "convex": "^1.39.1",
    "docx": "^9.6.1",
    "framer-motion": "^12.40.0",
    "jose": "^6.2.3",
    "lucide-react": "^1.16.0",
    "next": "^16.2.6",
    "pdf-lib": "^1.17.1",
    "puppeteer": "^25.0.4",
    "puppeteer-core": "^25.0.4",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.6",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  },
  "overrides": {
    "postcss": "^8.5.15",
    "ws": "^8.21.0"
  }
}
